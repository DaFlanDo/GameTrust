# Обязательные. Сгенерировать:
#   python -c "import secrets; print(secrets.token_hex(32))"
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_KEY=change-me
FERNET_SECRET_KEY=change-me

# Только для docker compose
POSTGRES_PASSWORD=change-me

# Без DATABASE_URL локально используется SQLite (instance/gametrust.db)
# DATABASE_URL=postgresql://gametrust:пароль@localhost:5432/gametrust
# REDIS_URL=redis://localhost:6379/0

# Почта для подтверждения email. Без неё ссылка подтверждения пишется в лог
# SMTP_SERVER=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=
# SMTP_PASSWORD=

# За HTTPS включить, чтобы cookie уходили только по защищённому соединению
# COOKIE_SECURE=1

# Публичный демо-стенд: кнопки «Войти как покупатель / продавец / админ» без пароля.
# В docker compose включён по умолчанию, вместе с SEED_DEMO
# DEMO_MODE=1
